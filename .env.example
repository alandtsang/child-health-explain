# ============================================================
# 环境配置模板 - 复制本文件为 .env 并填入实际值
# 使用方法：
#   1. cp .env.example .env
#   2. 填入实际值
#   3. 运行 node scripts/sync-env.js 自动分发到各文件
# ============================================================

# 微信小程序 AppID（填写你的小程序 AppID）
WX_APPID=

# 云开发环境ID
CLOUD_ENV=

# 火山方舟(豆包) API Key
# 获取地址：https://console.volcengine.com/ark
ARK_API_KEY=

# 腾讯云密钥（用于 OCR 识别，仅 ocrParse 云函数需要）
# 获取地址：https://console.cloud.tencent.com/cam/capi
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# 订阅消息模板ID（在微信公众平台后台 → 订阅消息 → 创建模板后填入）
# 用于家长端接收报告推送、随访提醒等通知
SUBSCRIBE_TEMPLATE_REPORT_PUSH=
SUBSCRIBE_TEMPLATE_FOLLOWUP_REMIND=
SUBSCRIBE_TEMPLATE_VIDEO_DONE=

# 腾讯云短信配置（用于短信兜底，仅 report_push / followup_remind 使用）
# 获取地址：https://console.cloud.tencent.com/smsv2
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_REPORT_PUSH=
SMS_TEMPLATE_FOLLOWUP_REMIND=
