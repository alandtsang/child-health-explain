# ============================================================
# 环境配置模板 - 复制本文件为 .env 并填入实际值
# 使用方法：
#   1. cp .env.example .env
#   2. 填入实际值
#   3. 运行 node scripts/sync-env.js 自动分发到各文件
# ============================================================

# 微信小程序 AppID（填写你的小程序 AppID）
WX_APPID=

# 云开发环境ID
CLOUD_ENV=

# 火山方舟(豆包) API Key
# 获取地址：https://console.volcengine.com/ark
ARK_API_KEY=

# 腾讯云密钥（用于 OCR 识别，仅 ocrParse 云函数需要）
# 获取地址：https://console.cloud.tencent.com/cam/capi
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
