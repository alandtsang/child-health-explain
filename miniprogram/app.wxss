/* miniprogram/app.wxss - 全局样式 */
page { background-color: #F5F6FA; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #333; font-size: 28rpx; }

/* 卡片 */
.card { background: #FFF; border-radius: 16rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }

/* 主按钮 */
.btn-primary { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #4A90D9, #6BB5E8); color: #FFF; font-size: 32rpx; font-weight: 600; padding: 28rpx 0; border-radius: 16rpx; }
.btn-primary:active { opacity: 0.85; }

/* 次按钮 */
.btn-secondary { display: flex; align-items: center; justify-content: center; background: #FFF; color: #4A90D9; font-size: 32rpx; font-weight: 600; padding: 28rpx 0; border-radius: 16rpx; border: 2rpx solid #4A90D9; }
.btn-secondary:active { opacity: 0.85; }

/* 文字按钮 */
.btn-text { text-align: center; font-size: 28rpx; color: #4A90D9; padding: 24rpx 0; }

/* 禁用状态 */
.btn-disabled { opacity: 0.5; pointer-events: none; }

/* 文字颜色 */
.text-primary { color: #4A90D9; }
.text-success { color: #52C41A; }
.text-warning { color: #FAAD14; }
.text-danger { color: #FF4D4F; }

/* 安全区底部 */
.safe-bottom { padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 40rpx; color: #999; font-size: 28rpx; }
.empty-state .empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-state .empty-hint { font-size: 24rpx; color: #BBB; margin-top: 8rpx; }

/* 加载更多 */
.loading-more, .no-more { text-align: center; padding: 24rpx; font-size: 24rpx; color: #999; }
