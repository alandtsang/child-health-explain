.poster-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-container {
  width: 88%;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.poster-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}

.poster-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.poster-close {
  padding: 8rpx 16rpx;
}

.close-icon {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.poster-image {
  width: 100%;
  max-height: 55vh;
  background: #f5f5f5;
}

.poster-disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 12rpx 0;
  background: #fafafa;
}

.poster-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.action-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
  line-height: 80rpx;
  height: 80rpx;
}

.save-btn {
  background: #4a90d9;
  color: #fff;
}

.share-btn {
  background: #f5f5f5;
  color: #333;
  border: 1rpx solid #ddd;
}
