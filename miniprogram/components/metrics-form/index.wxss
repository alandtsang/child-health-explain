.metrics-form { width: 100%; }
.category-block { margin-bottom: 16rpx; background: #FFF; border-radius: 16rpx; overflow: hidden; }
.category-header { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; }
.category-label { font-size: 30rpx; font-weight: 600; color: #333; }
.category-arrow { font-size: 40rpx; color: #CCC; transition: transform 0.2s; transform: rotate(0deg); }
.category-arrow.expanded { transform: rotate(90deg); }
.category-body { padding: 0 32rpx 24rpx; }
.field-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.field-item:last-child { border-bottom: none; }
.field-label { width: 240rpx; font-size: 28rpx; color: #666; flex-shrink: 0; }
.field-input { flex: 1; font-size: 28rpx; color: #333; text-align: right; }
