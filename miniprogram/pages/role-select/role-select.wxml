<view class="role-select-page">
  <view class="logo-section">
    <view class="logo-icon"><text class="logo-emoji">🏥</text></view>
    <text class="app-title">儿童健康体检</text>
    <text class="app-subtitle">AI科普与随访管理</text>
  </view>

  <!-- 返回用户：快速继续入口 -->
  <view class="quick-continue" wx:if="{{lastRole}}" bindtap="onQuickContinue">
    <text class="quick-label">欢迎回来{{userName ? '，' + userName : ''}}</text>
    <view class="quick-action">
      <text class="quick-text">直接进入{{lastRole === 'doctor' ? '医生' : '家长'}}工作台</text>
      <text class="quick-arrow">›</text>
    </view>
  </view>

  <view class="role-section">
    <text class="section-title">{{lastRole ? '或切换身份' : '请选择您的身份'}}</text>
    <view class="role-card" bindtap="onSelectDoctor">
      <view class="role-icon doctor-icon"><text class="role-emoji">👨‍⚕️</text></view>
      <view class="role-info">
        <text class="role-name">我是医生</text>
        <text class="role-desc">录入体检、AI解读、审核推送、随访管理</text>
      </view>
      <view class="role-arrow"><text class="arrow-icon">›</text></view>
    </view>
    <view class="role-card" bindtap="onSelectParent">
      <view class="role-icon parent-icon"><text class="role-emoji">👨‍👩‍👧</text></view>
      <view class="role-info">
        <text class="role-name">我是家长</text>
        <text class="role-desc">查看报告、拍照自查、科普海报、随访提醒</text>
      </view>
      <view class="role-arrow"><text class="arrow-icon">›</text></view>
    </view>

    <!-- 管理员入口：仅管理员可见 -->
    <view class="role-card admin-card" wx:if="{{isAdmin}}" bindtap="onAdminReview">
      <view class="role-icon admin-icon"><text class="role-emoji">🛡️</text></view>
      <view class="role-info">
        <text class="role-name">医生认证审核</text>
        <text class="role-desc">审核医生提交的认证申请</text>
      </view>
      <view class="role-arrow"><text class="arrow-icon">›</text></view>
    </view>
  </view>
  <view class="footer-section">
    <text class="footer-text">医生身份需提交认证申请，管理员审核通过后激活</text>
    <text class="footer-text">家长身份即选即用</text>
  </view>
</view>
<loading-overlay visible="{{loading}}" text="请稍候..." />
