.ocr-review-page { padding: 24rpx; padding-bottom: 120rpx; }
.card { background: #FFF; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; }
.card-title { font-size: 32rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }
.ocr-image { width: 100%; border-radius: 12rpx; }
.confidence-bar { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #F0F0F0; }
.confidence-label { font-size: 26rpx; color: #999; }
.confidence-value { font-size: 28rpx; font-weight: 600; color: #52C41A; }
.confidence-value.low { color: #FAAD14; }
.review-hint { display: flex; align-items: center; background: #FFFBE6; border-radius: 12rpx; padding: 20rpx 24rpx; margin-bottom: 24rpx; }
.hint-icon { font-size: 32rpx; margin-right: 12rpx; }
.hint-text { font-size: 26rpx; color: #FAAD14; }
.action-bar { display: flex; gap: 24rpx; margin-top: 32rpx; }
.action-btn-half { flex: 1; }
