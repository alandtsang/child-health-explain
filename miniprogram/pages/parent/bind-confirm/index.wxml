<view class="bind-page">
  <block wx:if="{{loading}}">
    <view class="loading-tip">正在查询邀请...</view>
  </block>

  <block wx:elif="{{bindSuccess}}">
    <view class="success-card">
      <view class="success-icon">✓</view>
      <text class="success-title">绑定成功</text>
      <text class="success-desc">已添加 {{child.name}} 的档案</text>
    </view>
  </block>

  <block wx:elif="{{child}}">
    <view class="card">
      <view class="card-title">确认儿童档案</view>
      <view class="child-summary">
        <view class="info-row"><text class="label">姓名</text><text class="value">{{child.name}}</text></view>
        <view class="info-row"><text class="label">性别</text><text class="value">{{child.gender}}</text></view>
        <view class="info-row"><text class="label">出生日期</text><text class="value">{{child.birth_date}}</text></view>
      </view>
      <view class="confirm-tip">请确认这是您的孩子后点击下方按钮</view>
      <button class="btn-primary" bindtap="onConfirmBind" loading="{{binding}}">确认是我的孩子</button>
      <view class="btn-cancel" bindtap="onCancel">不是，取消</view>
    </view>
  </block>

  <block wx:elif="{{showManualInput}}">
    <view class="card">
      <view class="card-title">输入邀请码</view>
      <input class="code-input" placeholder="6位邀请码" value="{{manualCode}}" bindinput="onManualInput" maxlength="6" />
      <button class="btn-primary" bindtap="onManualSubmit">查询</button>
    </view>
  </block>

  <block wx:elif="{{error}}">
    <view class="error-card">
      <view class="error-icon">!</view>
      <text class="error-msg">{{error}}</text>
      <view class="btn-cancel" bindtap="onCancel">返回</view>
    </view>
  </block>
</view>
