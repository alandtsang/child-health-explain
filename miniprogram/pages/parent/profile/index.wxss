.profile-page { padding: 24rpx; }
.profile-header { display: flex; align-items: center; background: linear-gradient(135deg, #4A90D9, #6BB5E8); border-radius: 24rpx; padding: 40rpx 32rpx; margin-bottom: 24rpx; }
.avatar { width: 120rpx; height: 120rpx; background: rgba(255,255,255,0.25); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; }
.avatar-text { font-size: 48rpx; color: #FFF; font-weight: 600; }
.profile-info { flex: 1; }
.profile-name { font-size: 36rpx; font-weight: 700; color: #FFF; display: block; }
.phone-row { margin-top: 8rpx; }
.phone-text { font-size: 26rpx; color: rgba(255,255,255,0.85); }
.bind-phone-btn { display: inline-block; font-size: 24rpx; color: #FFF; background: rgba(255,255,255,0.2); padding: 4rpx 20rpx; border-radius: 20rpx; line-height: 1.8; }
.bind-phone-btn::after { border: none; }
.section { margin-bottom: 24rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: #333; }
.section-add { font-size: 28rpx; color: #4A90D9; }
.empty-children { text-align: center; padding: 40rpx 0; color: #999; font-size: 28rpx; background: #FFF; border-radius: 16rpx; }
.child-item { display: flex; align-items: center; padding: 24rpx 32rpx; margin-bottom: 16rpx; }
.child-item-avatar { width: 72rpx; height: 72rpx; background: #E8F2FD; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; font-size: 32rpx; color: #4A90D9; }
.child-item-info { flex: 1; }
.child-item-name { font-size: 30rpx; font-weight: 600; color: #333; display: block; }
.child-item-meta { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.child-item-arrow { font-size: 40rpx; color: #CCC; }
.card { background: #FFF; border-radius: 16rpx; }
.action-card { display: flex; justify-content: space-between; align-items: center; padding: 32rpx; margin-bottom: 16rpx; }
.action-label { font-size: 30rpx; color: #333; }
.action-label.danger { color: #FF4D4F; }
.action-arrow { font-size: 40rpx; color: #CCC; }
.version-text { text-align: center; font-size: 24rpx; color: #CCC; padding: 40rpx 0; }
