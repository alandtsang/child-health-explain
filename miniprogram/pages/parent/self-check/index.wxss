.self-check-page { padding: 24rpx; padding-bottom: 120rpx; }
.step-section { width: 100%; }
.step-title { font-size: 34rpx; font-weight: 600; color: #333; margin-bottom: 24rpx; }
.child-card { display: flex; align-items: center; justify-content: space-between; padding: 32rpx; }
.child-card-info { flex: 1; }
.child-card-name { font-size: 32rpx; font-weight: 600; color: #333; display: block; }
.child-card-meta { font-size: 24rpx; color: #999; margin-top: 8rpx; display: block; }
.child-card-arrow { font-size: 48rpx; color: #CCC; }
.empty-state { text-align: center; padding: 80rpx 0; color: #999; }
.card { background: #FFF; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; }
.form-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.form-item:last-child { border-bottom: none; }
.form-label { width: 160rpx; font-size: 28rpx; color: #666; flex-shrink: 0; }
.form-input { flex: 1; font-size: 28rpx; color: #333; }
.radio-label { font-size: 28rpx; margin-right: 32rpx; }
.method-card { display: flex; align-items: center; background: #FFF; border-radius: 16rpx; padding: 40rpx 32rpx; margin-bottom: 24rpx; }
.method-icon { font-size: 56rpx; margin-right: 24rpx; }
.method-info { flex: 1; }
.method-name { font-size: 32rpx; font-weight: 600; color: #333; display: block; }
.method-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; display: block; }
.method-arrow { font-size: 48rpx; color: #CCC; }
.form-header { margin-bottom: 24rpx; }
.child-info-bar { background: #FFF; border-radius: 16rpx; padding: 24rpx 32rpx; margin-bottom: 16rpx; }
.child-info-name { font-size: 32rpx; font-weight: 600; color: #333; }
.child-info-meta { font-size: 24rpx; color: #999; margin-left: 16rpx; }
.exam-date-bar { display: flex; align-items: center; background: #FFF; border-radius: 16rpx; padding: 24rpx 32rpx; }
.date-value { flex: 1; text-align: right; font-size: 28rpx; color: #4A90D9; }
.consent-card { }
.consent-text { font-size: 28rpx; color: #666; line-height: 1.8; display: block; margin-bottom: 16rpx; }
.consent-check-group { margin-top: 24rpx; }
.consent-check-label { font-size: 28rpx; color: #333; }
.action-full { width: 100%; box-sizing: border-box; margin-top: 32rpx; }
.btn-disabled { opacity: 0.5; }
