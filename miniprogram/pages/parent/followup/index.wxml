<!-- miniprogram/pages/parent/followup/index.wxml -->
<view class="followup-page">
  <view wx:if="{{followups.length === 0 && !loading}}" class="empty-state">
    <text class="empty-icon">📅</text>
    <text>暂无待办随访</text>
    <text class="empty-hint">医生审核报告后如有异常项会创建随访计划</text>
  </view>

  <view wx:for="{{followups}}" wx:key="_id" class="followup-card card" bindtap="onFollowupTap" data-id="{{item._id}}">
    <view class="fu-header">
      <text class="fu-child">{{item.child_name}}</text>
      <view class="fu-days-badge {{item.days_left < 0 ? 'overdue' : ''}}">
        <text>{{item.days_text}}</text>
      </view>
    </view>
    <view class="fu-body">
      <text class="fu-trigger">{{item.trigger_summary}}</text>
      <text class="fu-date">计划复查日期：{{item.plan_date_fmt}}</text>
    </view>
    <view class="fu-footer" wx:if="{{item.days_left < 0}}">
      <text class="fu-overdue-hint">已超期，请尽快复查</text>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="loading-more">加载中...</view>
  <view wx:if="{{!hasMore && followups.length > 0}}" class="no-more">没有更多了</view>
</view>

<!-- 详情弹窗 -->
<view wx:if="{{detailVisible}}" class="modal-overlay" bindtap="onCloseDetail">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">随访详情</text>
      <text class="modal-close" bindtap="onCloseDetail">×</text>
    </view>
    <view class="modal-body" wx:if="{{detailFollowup}}">
      <view class="detail-row"><text class="detail-label">儿童</text><text class="detail-value">{{detailFollowup.child_name}}</text></view>
      <view class="detail-row"><text class="detail-label">计划日期</text><text class="detail-value">{{detailFollowup.plan_date_fmt}}</text></view>
      <view class="detail-row"><text class="detail-label">状态</text><text class="detail-value">{{detailFollowup.days_text}}</text></view>
      <view class="detail-section">
        <text class="detail-section-title">需关注的异常项</text>
        <view wx:for="{{detailFollowup.trigger_items}}" wx:key="item" class="trigger-item">
          <view class="trigger-left">
            <text class="trigger-name">{{item.item}}</text>
            <text class="trigger-value">{{item.value}}</text>
          </view>
          <abnormal-tag level="{{item.level}}" />
        </view>
      </view>
      <view class="detail-section" wx:if="{{detailFollowup.advice}}">
        <text class="detail-section-title">复查建议</text>
        <text class="advice-content">{{detailFollowup.advice}}</text>
      </view>
    </view>
    <view class="modal-actions">
      <view class="btn-primary modal-btn" bindtap="onConfirmCompleted">已复查，确认完成</view>
    </view>
  </view>
</view>

<loading-overlay visible="{{loading}}" text="加载中..." />
<loading-overlay visible="{{completing}}" text="处理中..." />
