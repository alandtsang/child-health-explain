/* miniprogram/pages/doctor/ocr-review/ocr-review.wxss */
.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* 原图区域 */
.image-section {
  text-align: center;
}

.ocr-image {
  width: 100%;
  max-height: 400rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.image-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 置信度区域 */
.confidence-section {
  padding: 24rpx 32rpx;
}

.confidence-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.confidence-label {
  font-size: 28rpx;
  color: #666;
}

.confidence-value {
  font-size: 30rpx;
  font-weight: 600;
}

.manual-warning {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff8e6;
  border-radius: 8rpx;
  border-left: 6rpx solid #fa8c16;
}

.manual-warning text {
  font-size: 24rpx;
  color: #fa8c16;
  line-height: 1.6;
}

/* 信息选择区域 */
.info-section {
  padding: 8rpx 32rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

.picker-value.placeholder {
  color: #ccc;
}

/* 表单区域 */
.form-section {
  padding: 0;
  overflow: hidden;
}

.form-section .card-title {
  padding: 24rpx 32rpx 0;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-bar .btn-primary {
  width: 100%;
}
