.review-page { padding: 24rpx; padding-bottom: 160rpx; }
.card { background: #FFF; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.card-title { font-size: 32rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; display: flex; align-items: center; }
.info-card .info-header { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 16rpx; }
.child-name { font-size: 36rpx; font-weight: 700; color: #333; }
.child-meta { font-size: 26rpx; color: #999; }
.info-row { display: flex; justify-content: space-between; padding: 12rpx 0; }
.info-label { font-size: 28rpx; color: #999; }
.info-value { font-size: 28rpx; color: #333; }
.abnormal-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.abnormal-row:last-child { border-bottom: none; }
.abnormal-left { flex: 1; }
.abnormal-item { font-size: 30rpx; color: #333; display: block; }
.abnormal-value { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.abnormal-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.abnormal-ref { font-size: 22rpx; color: #BBB; }
.edit-card { position: relative; }
.modified-badge { font-size: 22rpx; color: #FFF; background: #FA8C16; padding: 4rpx 12rpx; border-radius: 8rpx; margin-left: 16rpx; font-weight: 400; }
.edit-textarea { width: 100%; min-height: 120rpx; font-size: 28rpx; color: #333; line-height: 1.6; }
.edit-textarea-sm { width: 100%; min-height: 80rpx; font-size: 26rpx; color: #333; line-height: 1.5; }
.edit-input { flex: 1; font-size: 28rpx; color: #333; }
.sub-card { background: #FAFAFA; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.sub-card:last-child { margin-bottom: 0; }
.sub-card-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }
.sub-field { margin-bottom: 16rpx; }
.sub-field:last-child { margin-bottom: 0; }
.sub-field-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.sub-label { font-size: 24rpx; color: #999; display: block; margin-bottom: 8rpx; }
.sub-field-row .sub-label { width: 120rpx; margin-bottom: 0; flex-shrink: 0; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; background: #FFF; padding: 16rpx 24rpx; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); z-index: 100; gap: 16rpx; }
.bottom-btn { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 12rpx; font-size: 30rpx; font-weight: 600; }
.btn-quick { background: #F0F5FF; color: #4A90D9; }
.btn-save { background: #4A90D9; color: #FFF; }
.btn-push { background: linear-gradient(135deg, #52C41A, #73D13D); color: #FFF; }
.btn-disabled { background: #CCC !important; }
.btn-delete { background: #FFF1F0; color: #FF4D4F; }
.btn-status { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 12rpx; font-size: 30rpx; font-weight: 600; background: #F5F5F5; color: #999; }
.btn-status-rejected { background: #FFF1F0; color: #FF4D4F; }

/* 报告尚未生成状态 */
.no-report-page { padding: 24rpx; }
.no-report-tip { text-align: center; padding: 80rpx 0 40rpx; display: flex; flex-direction: column; align-items: center; }
.no-report-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.no-report-text { font-size: 32rpx; color: #666; font-weight: 600; }
.no-report-hint { font-size: 26rpx; color: #BBB; margin-top: 8rpx; }
.generate-btn { margin: 0 24rpx 48rpx; background: linear-gradient(135deg, #4A90D9, #6BB5E8); color: #FFF; text-align: center; padding: 28rpx 0; border-radius: 12rpx; font-size: 32rpx; font-weight: 600; }
.delete-btn { margin: 0 24rpx 48rpx; background: #FFF1F0; color: #FF4D4F; text-align: center; padding: 24rpx 0; border-radius: 12rpx; font-size: 28rpx; font-weight: 500; }

/* 海报卡片 */
.poster-card { display: flex; flex-direction: column; }
.poster-preview { display: flex; flex-direction: column; align-items: center; }
.poster-thumb { width: 100%; height: 400rpx; border-radius: 12rpx; background: #F5F5F5; }
.poster-tap-hint { font-size: 24rpx; color: #BBB; margin-top: 12rpx; }
.poster-empty { display: flex; flex-direction: column; align-items: center; padding: 32rpx 0; }
.poster-empty-text { font-size: 28rpx; color: #999; margin-bottom: 24rpx; }
.poster-btn { background: linear-gradient(135deg, #4A90D9, #6BB5E8); color: #FFF; text-align: center; padding: 20rpx 64rpx; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; }
.poster-actions-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.poster-action-btn { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 10rpx; font-size: 26rpx; font-weight: 500; background: #F0F5FF; color: #4A90D9; }
.poster-regenerate { background: #FFF7E6; color: #FA8C16; }

/* 视频卡片 */
.video-card { display: flex; flex-direction: column; }
.video-preview { display: flex; flex-direction: column; align-items: center; }
.video-player { width: 100%; height: 400rpx; border-radius: 12rpx; background: #F5F5F5; }
.video-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.video-push-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; background: linear-gradient(135deg, #52C41A, #73D13D); color: #FFF; }

/* 邀请家长弹窗 */
.invite-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 999; display: flex; align-items: center; justify-content: center; }
.invite-dialog { background: #fff; border-radius: 16rpx; padding: 32rpx; width: 80%; max-width: 600rpx; }
.invite-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.qr-wrap { text-align: center; margin: 24rpx 0; }
.qr-img { width: 400rpx; height: 400rpx; }
.invite-code-row { display: flex; align-items: center; justify-content: center; margin: 16rpx 0; }
.invite-code-label { font-size: 28rpx; color: #7A8794; }
.invite-code { font-size: 40rpx; font-weight: 700; letter-spacing: 8rpx; color: #4A90D9; }
.invite-copy { font-size: 24rpx; color: #4A90D9; margin-left: 16rpx; }
.invite-tip { font-size: 24rpx; color: #7A8794; text-align: center; margin: 16rpx 0 24rpx; }
.invite-actions { display: flex; gap: 16rpx; }
.invite-btn { flex: 1; font-size: 28rpx; border-radius: 8rpx; }
.invite-btn-primary { background: #4A90D9; color: #fff; }
