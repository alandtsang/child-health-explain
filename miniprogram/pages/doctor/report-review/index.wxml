<!-- miniprogram/pages/doctor/report-review/index.wxml -->
<view class="review-page" wx:if="{{!loading && report}}">
  <!-- 体检基本信息 -->
  <view class="card info-card">
    <view class="info-header">
      <text class="child-name">{{child.name}}</text>
      <text class="child-meta">{{child.gender}} · {{exam.age_text}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">体检日期</text>
      <text class="info-value">{{exam.exam_date_fmt}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">录入方式</text>
      <text class="info-value">{{exam.source === 'ocr' ? '拍照上传' : '手动录入'}}</text>
    </view>
  </view>

  <!-- 异常分级一览（只读） -->
  <view class="card">
    <view class="card-title">异常分级一览</view>
    <view wx:if="{{exam.abnormal_items_fmt.length === 0}}" class="text-success">所有指标正常</view>
    <view wx:for="{{exam.abnormal_items_fmt}}" wx:key="item" class="abnormal-row">
      <view class="abnormal-left">
        <text class="abnormal-item">{{item.item_label || item.item}}</text>
        <text class="abnormal-value">{{item.value}}</text>
      </view>
      <view class="abnormal-right">
        <abnormal-tag level="{{item.level}}" />
        <text class="abnormal-ref">{{item.standard_ref || ''}}</text>
      </view>
    </view>
  </view>

  <!-- AI 解读内容 - 概况（可编辑） -->
  <view class="card edit-card">
    <view class="card-title">
      总体概况
      <text wx:if="{{hasChanges}}" class="modified-badge">已修改</text>
    </view>
    <textarea
      class="edit-textarea"
      value="{{editContent.summary}}"
      bindinput="onSummaryInput"
      placeholder="请输入总体概况"
      auto-height
      maxlength="-1"
    />
  </view>

  <!-- 指标解读（可编辑卡片） -->
  <view class="card edit-card">
    <view class="card-title">指标解读</view>
    <view wx:for="{{editContent.item_explanations}}" wx:key="index" class="sub-card">
      <view class="sub-card-title">第{{index + 1}}项：{{item.item}}</view>
      <view class="sub-field">
        <text class="sub-label">指标含义</text>
        <textarea class="edit-textarea-sm" value="{{item.meaning}}" data-index="{{index}}" data-field="meaning" bindinput="onExplanationInput" auto-height maxlength="-1" />
      </view>
      <view class="sub-field">
        <text class="sub-label">异常提示</text>
        <textarea class="edit-textarea-sm" value="{{item.abnormal_implication}}" data-index="{{index}}" data-field="abnormal_implication" bindinput="onExplanationInput" auto-height maxlength="-1" />
      </view>
    </view>
  </view>

  <!-- 分诊建议（可编辑） -->
  <view class="card edit-card">
    <view class="card-title">分诊建议</view>
    <view wx:for="{{editContent.triage_advice}}" wx:key="index" class="sub-card">
      <view class="sub-card-title">{{item.item}}</view>
      <view class="sub-field-row">
        <text class="sub-label">科室</text>
        <input class="edit-input" value="{{item.department}}" data-index="{{index}}" data-field="department" bindinput="onTriageInput" />
      </view>
      <view class="sub-field-row">
        <text class="sub-label">紧急程度</text>
        <input class="edit-input" value="{{item.urgency}}" data-index="{{index}}" data-field="urgency" bindinput="onTriageInput" />
      </view>
      <view class="sub-field">
        <text class="sub-label">原因</text>
        <textarea class="edit-textarea-sm" value="{{item.reason}}" data-index="{{index}}" data-field="reason" bindinput="onTriageInput" auto-height maxlength="-1" />
      </view>
    </view>
  </view>

  <!-- 家庭干预（可编辑） -->
  <view class="card edit-card">
    <view class="card-title">家庭干预</view>
    <view wx:for="{{editContent.home_interventions}}" wx:key="index" class="sub-card">
      <view class="sub-card-title">{{item.item}}（{{item.type}}）</view>
      <view class="sub-field">
        <text class="sub-label">详细建议</text>
        <textarea class="edit-textarea-sm" value="{{item.detail}}" data-index="{{index}}" data-field="detail" bindinput="onInterventionInput" auto-height maxlength="-1" />
      </view>
    </view>
  </view>

  <!-- 医生备注 -->
  <view class="card edit-card">
    <view class="card-title">医生备注</view>
    <textarea
      class="edit-textarea"
      value="{{doctorNote}}"
      bindinput="onNoteInput"
      placeholder="可添加医生补充说明（家长不可见此备注）"
      auto-height
      maxlength="-1"
    />
  </view>

  <!-- 科普海报 -->
  <view class="card poster-card">
    <view class="card-title">科普海报</view>
    <view wx:if="{{poster}}" class="poster-preview" bindtap="onViewPoster">
      <image class="poster-thumb" src="{{poster.file_id}}" mode="aspectFit" />
      <text class="poster-tap-hint">点击查看大图</text>
    </view>
    <view wx:else class="poster-empty">
      <text class="poster-empty-text">暂无海报</text>
      <view class="poster-btn {{generatingPoster ? 'btn-disabled' : ''}}" bindtap="onGeneratePoster">
        {{generatingPoster ? '生成中...' : '生成海报'}}
      </view>
    </view>
    <view wx:if="{{poster}}" class="poster-actions-row">
      <view class="poster-action-btn" bindtap="onViewPoster">查看海报</view>
      <view class="poster-action-btn poster-regenerate" bindtap="onRegeneratePoster">重新生成</view>
    </view>
  </view>

  <!-- 科普视频（已推送的科普视频列表） -->
  <view class="card video-card" wx:if="{{videos.length > 0}}">
    <view class="card-title">科普视频</view>
    <view wx:for="{{videos}}" wx:key="_id" class="video-list-item">
      <view class="video-item-header">
        <text class="video-item-title">{{item.title || item.category_label || item.category || '科普视频'}}</text>
        <text class="video-item-tag">已推送</text>
      </view>
      <view class="video-preview">
        <video src="{{item.file_id}}" class="video-player" controls></video>
      </view>
    </view>
  </view>

  <!-- 待推送科普视频预览（推送前根据异常项匹配，仅在未推送时显示） -->
  <view class="card preview-video-card" wx:if="{{(btnState === 'review' || btnState === 'pending_binding') && previewVideos.length > 0}}">
    <view class="card-title">
      待推送科普视频
      <text class="preview-count-badge">{{previewVideos.length}}个</text>
    </view>
    <view class="preview-hint">根据体检异常项自动匹配，推送报告时一并发送给家长</view>
    <view wx:for="{{previewVideos}}" wx:key="_id" class="preview-video-item">
      <view class="preview-video-thumb" wx:if="{{item.thumbnail_file_id}}">
        <image src="{{item.thumbnail_file_id}}" mode="aspectFill" class="preview-thumb-img" />
        <view class="preview-play-icon">▶</view>
      </view>
      <view class="preview-video-thumb preview-video-placeholder" wx:else>
        <text class="preview-placeholder-icon">🎬</text>
      </view>
      <view class="preview-video-info">
        <text class="preview-video-title">{{item.display_title}}</text>
        <view class="preview-video-meta">
          <text class="preview-video-category">{{item.category_label || item.category}}</text>
          <text wx:if="{{item.duration_text}}" class="preview-video-duration">{{item.duration_text}}</text>
        </view>
        <text wx:if="{{item.description}}" class="preview-video-desc">{{item.description}}</text>
      </view>
      <text class="preview-video-tag">推送时发送</text>
    </view>
    <view wx:if="{{previewSkippedCategories.length > 0}}" class="preview-skipped">
      <text class="preview-skipped-text">以下异常项暂无匹配视频：{{previewSkippedCategories}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar safe-bottom">
    <!-- 待审核：完整操作按钮 -->
    <block wx:if="{{btnState === 'review'}}">
      <view class="bottom-btn btn-delete" bindtap="onDeleteExam">删除</view>
      <view class="bottom-btn btn-quick" bindtap="onQuickApprove">一键通过</view>
      <view class="bottom-btn btn-save {{hasChanges ? '' : 'btn-disabled'}}" bindtap="onSaveChanges">保存修改</view>
      <view class="bottom-btn btn-push" bindtap="onApproveAndPush">{{isBound ? '通过并推送' : '通过并邀请家长'}}</view>
    </block>
    <!-- 已审核待绑定：家长已绑定可补推，否则等待 -->
    <block wx:elif="{{btnState === 'pending_binding'}}">
      <view wx:if="{{isBound}}" class="bottom-btn btn-push" bindtap="onApproveAndPush">推送给家长</view>
      <view wx:else class="bottom-btn btn-status">待家长绑定后自动推送</view>
    </block>
    <!-- 已推送 -->
    <view wx:elif="{{btnState === 'pushed'}}" class="bottom-btn btn-status">已审核已推送</view>
    <!-- 已驳回 -->
    <view wx:elif="{{btnState === 'rejected'}}" class="bottom-btn btn-status btn-status-rejected">已驳回</view>
  </view>
</view>

<!-- 邀请家长弹窗 -->
<view wx:if="{{inviteVisible}}" class="invite-mask" bindtap="onCloseInvite">
  <view class="invite-dialog" catchtap="">
    <view class="invite-title">家长绑定邀请</view>
    <view wx:if="{{inviteData.qr_file_id}}" class="qr-wrap">
      <image src="{{inviteData.qr_file_id}}" mode="aspectFit" class="qr-img" />
    </view>
    <view class="invite-code-row">
      <text class="invite-code-label">邀请码：</text>
      <text class="invite-code">{{inviteData.code}}</text>
      <text class="invite-copy" bindtap="onCopyCode">复制</text>
    </view>
    <view class="invite-tip">有效期 {{inviteData.expires_in_days}} 天，家长扫码或输入邀请码即可绑定</view>
    <view class="invite-actions">
      <button wx:if="{{inviteData.qr_file_id}}" class="invite-btn" bindtap="onSaveQr">保存二维码</button>
      <button class="invite-btn invite-btn-primary" bindtap="onCloseInvite">完成</button>
    </view>
  </view>
</view>

<!-- 报告尚未生成：展示体检信息 + 生成按钮 -->
<view wx:if="{{!loading && noReport}}" class="no-report-page">
  <view class="card info-card">
    <view class="info-header">
      <text class="child-name">{{child.name}}</text>
      <text class="child-meta">{{child.gender}} · {{exam.age_text}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">体检日期</text>
      <text class="info-value">{{exam.exam_date_fmt}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">录入方式</text>
      <text class="info-value">{{exam.source === 'ocr' ? '拍照上传' : '手动录入'}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">异常分级一览</view>
    <view wx:if="{{exam.abnormal_items_fmt.length === 0}}" class="text-success">所有指标正常</view>
    <view wx:for="{{exam.abnormal_items_fmt}}" wx:key="item" class="abnormal-row">
      <view class="abnormal-left">
        <text class="abnormal-item">{{item.item_label || item.item}}</text>
        <text class="abnormal-value">{{item.value}}</text>
      </view>
      <view class="abnormal-right">
        <abnormal-tag level="{{item.level}}" />
        <text class="abnormal-ref">{{item.standard_ref || ''}}</text>
      </view>
    </view>
  </view>

  <view class="no-report-tip">
    <text class="no-report-icon">📄</text>
    <text class="no-report-text">AI解读报告尚未生成</text>
    <text class="no-report-hint">点击下方按钮生成解读报告</text>
  </view>
  <view class="generate-btn {{generating ? 'btn-disabled' : ''}}" bindtap="onGenerateReport">
    <text>{{generating ? '生成中...' : '生成解读报告'}}</text>
  </view>
  <view class="delete-btn" bindtap="onDeleteExam">
    <text>删除此体检记录</text>
  </view>
</view>

<view wx:if="{{!loading && !report && !noReport}}" class="empty-state">
  <text>报告加载失败</text>
</view>

<loading-overlay visible="{{loading}}" text="加载中..." />
<loading-overlay visible="{{submitting}}" text="提交中..." />
<loading-overlay visible="{{generating}}" text="AI解读生成中..." />
<loading-overlay visible="{{generatingPoster}}" text="海报生成中..." />
