/* miniprogram/pages/doctor/cert-apply/index.wxss */

.cert-page {
  min-height: 100vh;
  padding: 32rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F5F6FA;
}

/* === 顶部标题区 === */
.cert-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 40rpx;
}
.header-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #4A90D9, #6BB5E8);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.3);
}
.header-emoji {
  font-size: 64rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}
.header-subtitle {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  padding: 0 32rpx;
  line-height: 1.5;
}

/* === 卡片 === */
.card {
  background: #FFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* === 表单 === */
.form-item {
  margin-bottom: 28rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.form-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  background: #FAFBFC;
  overflow: visible;
}
.form-input:focus {
  border-color: #4A90D9;
  background: #FFF;
}

/* === 驳回提示 === */
.reject-tip {
  background: #FFF7F0;
  border: 1rpx solid #FFD7A8;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.reject-tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #FA8C16;
  margin-bottom: 8rpx;
}
.reject-tip-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* === 证件照片上传 === */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.photo-thumb {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}
.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFF;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.photo-upload {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #C8D0DC;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAFBFC;
}
.photo-upload:active {
  background: #F0F4F9;
  border-color: #4A90D9;
}
.upload-icon {
  font-size: 56rpx;
  color: #4A90D9;
  line-height: 1;
}
.upload-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* === 提交按钮 === */
.submit-btn {
  width: 100%;
  box-sizing: border-box;
  background: #4A90D9;
  color: #FFF;
  border-radius: 48rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-top: 16rpx;
}
.submit-btn:active {
  opacity: 0.85;
}
.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* === 状态视图（加载中 / 审核中 / 已通过） === */
.status-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx 32rpx;
}
.status-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  line-height: 1;
}
.status-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.status-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}
.status-hint {
  font-size: 24rpx;
  color: #BBB;
  margin-top: 24rpx;
  text-align: center;
}

/* === 详情卡片 === */
.detail-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 16rpx;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.detail-row:last-child {
  border-bottom: none;
}
.detail-label {
  font-size: 28rpx;
  color: #999;
}
.detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
