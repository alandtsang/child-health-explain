.profile-page { padding: 24rpx; padding-bottom: 120rpx; }
.profile-header { display: flex; align-items: center; background: linear-gradient(135deg, #4A90D9, #6BB5E8); border-radius: 24rpx; padding: 40rpx 32rpx; margin-bottom: 24rpx; }
.avatar { width: 120rpx; height: 120rpx; background: rgba(255,255,255,0.25); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; }
.avatar-text { font-size: 48rpx; color: #FFF; font-weight: 600; }
.profile-info { flex: 1; }
.profile-name { font-size: 38rpx; font-weight: 600; color: #FFF; display: block; }
.profile-title { font-size: 26rpx; color: rgba(255,255,255,0.85); margin-top: 8rpx; display: block; }
.info-card { padding: 32rpx; }
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 28rpx; color: #999; }
.info-value { font-size: 28rpx; color: #333; }
.status-approved { color: #52C41A; }
.status-pending { color: #FAAD14; }
.status-rejected { color: #FF4D4F; }
.action-card { display: flex; justify-content: space-between; align-items: center; padding: 32rpx; }
.action-label { font-size: 30rpx; color: #333; }
.action-label.danger { color: #FF4D4F; }
.action-arrow { font-size: 40rpx; color: #CCC; }
.version-text { text-align: center; font-size: 24rpx; color: #BBB; margin-top: 48rpx; }
