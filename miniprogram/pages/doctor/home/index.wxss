.doctor-home { padding: 24rpx; padding-bottom: 120rpx; }
.doctor-header { display: flex; align-items: center; background: linear-gradient(135deg, #4A90D9, #6BB5E8); border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; }
.doctor-avatar { width: 96rpx; height: 96rpx; background: rgba(255,255,255,0.25); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; }
.avatar-text { font-size: 40rpx; color: #FFF; font-weight: 600; }
.doctor-meta { flex: 1; }
.doctor-name { font-size: 34rpx; font-weight: 600; color: #FFF; }
.doctor-hospital { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-top: 4rpx; }
.profile-btn { background: rgba(255,255,255,0.2); padding: 12rpx 24rpx; border-radius: 24rpx; }
.profile-text { font-size: 26rpx; color: #FFF; }
.stats-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.stat-card { flex: 1; background: #FFF; border-radius: 16rpx; padding: 28rpx 0; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.stat-num { font-size: 48rpx; font-weight: 700; display: block; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 8rpx; display: block; }
.quick-actions { margin-bottom: 32rpx; }
.action-btn { display: flex; align-items: center; justify-content: center; border-radius: 16rpx; padding: 32rpx 0; }
.primary-btn { background: linear-gradient(135deg, #4A90D9, #6BB5E8); }
.action-icon { font-size: 40rpx; margin-right: 16rpx; }
.action-text { font-size: 32rpx; font-weight: 600; color: #FFF; }
.action-row { display: flex; gap: 16rpx; margin-top: 16rpx; }
.action-btn-small { flex: 1; background: #FFF; border-radius: 16rpx; padding: 24rpx 0; display: flex; flex-direction: column; align-items: center; }
.action-icon-sm { font-size: 40rpx; }
.action-text-sm { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.section-header { margin-bottom: 16rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: #333; }
.empty-state { text-align: center; padding: 120rpx 0; color: #999; display: flex; flex-direction: column; align-items: center; }
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-hint { font-size: 24rpx; color: #BBB; margin-top: 8rpx; }
.exam-card { padding: 28rpx 32rpx; }
.exam-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.name-wrap { display: flex; align-items: center; gap: 12rpx; }
.draft-badge { font-size: 20rpx; color: #FFF; background: #FA8C16; padding: 2rpx 12rpx; border-radius: 6rpx; }
.child-name { font-size: 32rpx; font-weight: 600; color: #333; }
.exam-date { font-size: 24rpx; color: #999; }
.exam-card-body { display: flex; justify-content: space-between; align-items: center; }
.age-text { font-size: 26rpx; color: #666; }
.abnormal-info { display: flex; align-items: center; gap: 12rpx; }
.abnormal-count { font-size: 24rpx; color: #FA8C16; }
.loading-more, .no-more { text-align: center; padding: 24rpx; font-size: 24rpx; color: #999; }
